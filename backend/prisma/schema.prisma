generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Enums replaced with strings for SQLite support

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id             String    @id @default(uuid())
  fullName       String
  email          String    @unique
  password       String
  role           String    @default("EMPLOYEE")
  departmentId   String?
  managerId      String?
  avatarUrl      String?
  googleId       String?    @unique
  microsoftId    String?    @unique
  
  department     Department? @relation(fields: [departmentId], references: [id])
  manager        User?       @relation("ManagerHierarchy", fields: [managerId], references: [id])
  subordinates   User[]      @relation("ManagerHierarchy")
  
  goals          Goal[]
  approvalsGiven Approval[]  @relation("Approver")
  approvalsReceived Approval[] @relation("Requester")
  
  sharedGoalAssignments GoalAssignment[]
  quarterlyCheckins     QuarterlyCheckin[]
  comments              Comment[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  escalationsTarget     Escalation[] @relation("EscalationTarget")
  escalationsInitiated  Escalation[] @relation("EscalationInitiator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Goal {
  id               String     @id @default(uuid())
  employeeId       String
  title            String
  description      String
  thrustArea       String
  unitOfMeasure    String
  targetValue      Float
  achievementValue Float      @default(0)
  weightage        Float
  status           String @default("DRAFT")
  progressScore    Float      @default(0)
  dueDate          DateTime
  isShared         Boolean    @default(false)
  sharedGoalId     String?

  employee         User        @relation(fields: [employeeId], references: [id])
  sharedGoal       SharedGoal? @relation(fields: [sharedGoalId], references: [id])
  
  updates          GoalUpdate[]
  checkins         QuarterlyCheckin[]
  approvals        Approval[]
  comments         Comment[]
  
  lockedAt         DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  version          Int        @default(1)
  blockingGoals    GoalDependency[] @relation("BlockingGoals")
  dependentOn      GoalDependency[] @relation("DependentGoals")
}

model GoalDependency {
  id               String   @id @default(uuid())
  blockingGoalId   String
  dependentGoalId  String
  dependencyType   String   @default("BLOCKS")

  blockingGoal     Goal     @relation("BlockingGoals", fields: [blockingGoalId], references: [id])
  dependentGoal    Goal     @relation("DependentGoals", fields: [dependentGoalId], references: [id])

  createdAt        DateTime @default(now())
  
  @@unique([blockingGoalId, dependentGoalId])
}

model SharedGoal {
  id               String           @id @default(uuid())
  title            String
  description      String
  thrustArea       String
  unitOfMeasure    String
  targetValue      Float
  achievementValue Float            @default(0)
  creatorId        String
  
  assignments      GoalAssignment[]
  goals            Goal[]           // Linked individual goals that inherit this shared goal
  
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model GoalAssignment {
  id           String     @id @default(uuid())
  sharedGoalId String
  employeeId   String
  weightage    Float
  
  sharedGoal   SharedGoal @relation(fields: [sharedGoalId], references: [id])
  employee     User       @relation(fields: [employeeId], references: [id])

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([sharedGoalId, employeeId])
}

model GoalUpdate {
  id               String   @id @default(uuid())
  goalId           String
  previousValue    Float
  newValue         Float
  note             String?
  
  goal             Goal     @relation(fields: [goalId], references: [id])
  
  createdAt        DateTime @default(now())
}

model QuarterlyCheckin {
  id               String        @id @default(uuid())
  goalId           String
  employeeId       String
  cycleId          String
  plannedTarget    Float
  actualAchievement Float
  status           String
  notes            String?
  completionPercentage Float
  
  goal             Goal          @relation(fields: [goalId], references: [id])
  employee         User          @relation(fields: [employeeId], references: [id])
  cycle            Cycle         @relation(fields: [cycleId], references: [id])
  comments         Comment[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Approval {
  id           String     @id @default(uuid())
  goalId       String
  requesterId  String
  approverId   String
  status       String
  comments     String?
  
  goal         Goal       @relation(fields: [goalId], references: [id])
  requester    User       @relation("Requester", fields: [requesterId], references: [id])
  approver     User       @relation("Approver", fields: [approverId], references: [id])
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Cycle {
  id           String             @id @default(uuid())
  name         String             @unique // e.g. "Q2 2026"
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean            @default(false)
  
  checkins     QuarterlyCheckin[]
  
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Notification {
  id           String   @id @default(uuid())
  userId       String
  title        String
  message      String
  isRead       Boolean  @default(false)
  type         String   // e.g. "APPROVAL", "CHECKIN_REMINDER"
  referenceId  String?  // ID of related entity (goal, checkin, etc.)
  
  user         User     @relation(fields: [userId], references: [id])
  
  createdAt    DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  entityType   String   // "GOAL", "USER", etc.
  entityId     String
  action       String   // "CREATE", "UPDATE", "DELETE"
  beforeValue  String?
  afterValue   String?
  
  user         User?    @relation(fields: [userId], references: [id])
  
  createdAt    DateTime @default(now())
}

model Escalation {
  id           String   @id @default(uuid())
  targetId     String   // Person who needs to take action
  initiatorId  String?  // Person who initiated (or null if system)
  reason       String
  status       String   @default("OPEN") // OPEN, RESOLVED
  level        Int      @default(1) // 1 = Manager, 2 = Admin/HR
  
  target       User     @relation("EscalationTarget", fields: [targetId], references: [id])
  initiator    User?    @relation("EscalationInitiator", fields: [initiatorId], references: [id])
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Comment {
  id           String   @id @default(uuid())
  content      String
  userId       String
  goalId       String?
  checkinId    String?
  
  user         User     @relation(fields: [userId], references: [id])
  goal         Goal?    @relation(fields: [goalId], references: [id])
  checkin      QuarterlyCheckin? @relation(fields: [checkinId], references: [id])
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AnalyticsSnapshot {
  id           String   @id @default(uuid())
  cycleId      String
  departmentId String?
  data         String
  
  createdAt    DateTime @default(now())
}
